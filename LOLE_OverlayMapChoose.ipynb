<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LOLE Esports Tournament // Random Map Draw Overlay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&family=Oswald:wght@600;700&family=Rajdhani:wght@600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-void: #040916;
            --bg-navy: #0a1633;
            --bg-royal: #0f2557;
            --cyan-glow: #00f0ff;
            --cyan-mid: #3ba5ff;
            --gold-bright: #ffe600;
            --gold-deep: #ffc800;
            --text-white: #ffffff;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        html, body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: var(--bg-void);
            color: var(--text-white);
            font-family: 'Rajdhani', 'Inter', sans-serif;
        }

        /* Subtle Broadcast Tech Grid & Vignette */
        .tech-grid-overlay {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 40;
            background-image:
                radial-gradient(rgba(0, 240, 255, 0.06) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.015) 50%, rgba(0, 0, 0, 0.18) 50%);
            background-size: 28px 28px, 100% 4px;
        }

        .vignette-overlay {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 41;
            background: radial-gradient(circle at center, transparent 62%, rgba(2, 6, 16, 0.78) 100%);
        }

        /* =========================================
           MAIN SPLIT-SCREEN BROADCAST CONTAINER
           ========================================= */
        .container {
            display: flex;
            width: 100vw;
            height: 100vh;
            position: relative;
            background: linear-gradient(135deg, #040916 0%, #091736 50%, #050d21 100%);
        }

        /* =========================================
           LEFT PANEL (~26% Width) - Clean Auto-Broadcast Look
           ========================================= */
        .left-panel {
            width: 26%;
            min-width: 270px;
            height: 100%;
            position: relative;
            z-index: 20;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 2rem 2rem 2.6rem;
            background: linear-gradient(180deg, rgba(4, 10, 24, 0.97) 0%, rgba(9, 21, 48, 0.94) 60%, rgba(4, 9, 22, 0.98) 100%);
            border-right: 2px solid rgba(0, 240, 255, 0.35);
            box-shadow: 12px 0 40px rgba(0, 0, 0, 0.78);
        }

        .left-panel::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--gold-bright), var(--cyan-glow), transparent);
        }

        /* Top LOLE Tournament Brand & Uploaded Logo */
        .brand-header {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .lole-brand-card {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            background: linear-gradient(135deg, rgba(12, 28, 66, 0.88) 0%, rgba(5, 12, 28, 0.95) 100%);
            border: 1px solid rgba(0, 240, 255, 0.45);
            padding: 0.75rem 0.95rem;
            border-radius: 8px;
            box-shadow: 0 0 26px rgba(0, 240, 255, 0.18), inset 0 0 18px rgba(0, 240, 255, 0.08);
        }

        .lole-logo-wrap {
            width: 76px;
            height: 76px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: radial-gradient(circle, rgba(0, 240, 255, 0.16) 0%, rgba(4, 9, 22, 0.96) 76%);
            border: 1px solid rgba(0, 240, 255, 0.38);
            border-radius: 8px;
            padding: 4px;
            filter: drop-shadow(0 0 12px rgba(0, 240, 255, 0.35));
        }

        .lole-logo-wrap img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            display: block;
        }

        .lole-badge-text {
            display: flex;
            flex-direction: column;
            line-height: 1.06;
        }

        .lole-title-main {
            font-family: 'Oswald', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: 0.06em;
            color: #ffffff;
            text-transform: uppercase;
            text-shadow: 0 0 12px rgba(0, 240, 255, 0.45);
        }

        .lole-title-sub {
            font-family: 'Oswald', sans-serif;
            font-size: 0.88rem;
            font-weight: 700;
            letter-spacing: 0.12em;
            color: var(--gold-bright);
            text-transform: uppercase;
            margin-top: 2px;
        }

        .lole-org-tag {
            font-size: 0.66rem;
            font-weight: 700;
            letter-spacing: 0.16em;
            color: var(--cyan-glow);
            text-transform: uppercase;
            margin-top: 4px;
            opacity: 0.92;
        }

        .system-status-bar {
            display: flex;
            align-items: center;
            gap: 0.55rem;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.15em;
            color: rgba(255, 255, 255, 0.75);
            text-transform: uppercase;
            padding-left: 0.2rem;
        }

        .status-dot {
            width: 9px;
            height: 9px;
            border-radius: 50%;
            background: var(--cyan-glow);
            box-shadow: 0 0 10px var(--cyan-glow);
            animation: pulseDot 1.4s infinite ease-in-out;
        }

        .status-dot.drawing {
            background: var(--gold-bright);
            box-shadow: 0 0 14px var(--gold-bright);
            animation: pulseDot 0.32s infinite ease-in-out;
        }

        @keyframes pulseDot {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.35; transform: scale(0.75); }
        }

        /* Bottom Stacked Broadcast Typography (No Buttons) */
        .bottom-section {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
        }

        .title-mapdraw {
            font-family: 'Oswald', sans-serif;
            font-weight: 700;
            text-transform: uppercase;
            line-height: 0.88;
            letter-spacing: -0.01em;
            display: flex;
            flex-direction: column;
        }

        .title-random {
            font-size: clamp(3.5rem, 5.6vw, 5.8rem);
            color: var(--gold-bright);
            text-shadow: 0 0 32px rgba(255, 230, 0, 0.38);
        }

        .title-map,
        .title-draw {
            font-size: clamp(3.7rem, 5.9vw, 6.2rem);
            color: var(--text-white);
            text-shadow: 0 4px 22px rgba(0, 0, 0, 0.75);
        }

        .title-accent-line {
            width: 84px;
            height: 5px;
            background: linear-gradient(90deg, var(--gold-bright), var(--cyan-glow));
            margin-top: 0.75rem;
            border-radius: 2px;
        }

        /* =========================================
           RIGHT PANEL (~74% Width) - 4 Map Columns
           ========================================= */
        .right-panel {
            width: 74%;
            flex: 1;
            height: 100%;
            position: relative;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            overflow: hidden;
            background: #040814;
        }

        /* Global Sliding Yellow Arrow Indicator */
        .draw-arrow {
            position: absolute;
            top: 0;
            left: 12.5%;
            width: 0;
            height: 0;
            margin-left: -18px;
            border-left: 18px solid transparent;
            border-right: 18px solid transparent;
            border-top: 22px solid var(--gold-bright);
            z-index: 56;
            filter: drop-shadow(0 0 12px rgba(255, 230, 0, 0.95)) drop-shadow(0 4px 8px rgba(0, 240, 255, 0.8));
            transition: left 0.14s cubic-bezier(0.25, 1, 0.5, 1);
            pointer-events: none;
        }

        .draw-arrow::after {
            content: '';
            position: absolute;
            top: -24px;
            left: -10px;
            border-left: 10px solid transparent;
            border-right: 10px solid transparent;
            border-top: 12px solid #ffffff;
        }

        /* Individual Map Column */
        .map-col {
            position: relative;
            height: 100%;
            display: flex;
            flex-direction: column;
            border-right: 1px solid rgba(59, 165, 255, 0.24);
            overflow: hidden;
            transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), filter 0.18s ease, box-shadow 0.18s ease;
            filter: brightness(0.42) saturate(0.55);
        }

        .map-col:last-child {
            border-right: none;
        }

        .map-col.active {
            filter: brightness(1.12) saturate(1.22);
            transform: scale(1.024);
            z-index: 15;
            box-shadow:
                inset 0 0 0 2px var(--cyan-glow),
                inset 0 0 42px rgba(0, 240, 255, 0.45),
                0 0 38px rgba(0, 0, 0, 0.88);
        }

        .map-col.locked-winner {
            filter: brightness(1.26) saturate(1.3);
            transform: scale(1.045);
            z-index: 25;
            box-shadow:
                inset 0 0 0 3px var(--gold-bright),
                inset 0 0 65px rgba(255, 230, 0, 0.58),
                0 0 55px rgba(0, 240, 255, 0.75);
        }

        /* Top Map Header Bar */
        .map-header {
            position: relative;
            z-index: 10;
            height: 68px;
            padding: 1.15rem 0.65rem 0.65rem;
            background: linear-gradient(180deg, rgba(5, 11, 26, 0.95) 0%, rgba(10, 22, 51, 0.84) 100%);
            border-bottom: 2px solid rgba(59, 165, 255, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.48rem;
            transition: all 0.18s ease;
        }

        .map-col.active .map-header {
            background: linear-gradient(180deg, rgba(8, 30, 74, 0.97) 0%, rgba(16, 56, 118, 0.9) 100%);
            border-bottom: 2px solid var(--cyan-glow);
            box-shadow: 0 4px 20px rgba(0, 240, 255, 0.35);
        }

        .map-col.locked-winner .map-header {
            border-bottom: 2px solid var(--gold-bright);
            background: linear-gradient(180deg, rgba(52, 40, 4, 0.96) 0%, rgba(15, 37, 87, 0.92) 100%);
        }

        .map-icon {
            width: 10px;
            height: 10px;
            transform: rotate(45deg);
            background: rgba(59, 165, 255, 0.4);
            border: 1px solid var(--cyan-glow);
            opacity: 0.45;
            transition: all 0.18s ease;
            flex-shrink: 0;
        }

        .map-col.active .map-icon {
            opacity: 1;
            background: var(--cyan-glow);
            box-shadow: 0 0 10px var(--cyan-glow);
        }

        .map-col.locked-winner .map-icon {
            background: var(--gold-bright);
            border-color: #ffffff;
            box-shadow: 0 0 14px var(--gold-bright);
        }

        .map-title {
            font-family: 'Oswald', sans-serif;
            font-size: clamp(0.92rem, 1.32vw, 1.32rem);
            font-weight: 700;
            letter-spacing: 0.07em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.85);
            white-space: nowrap;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.85);
        }

        .map-col.active .map-title {
            color: #ffffff;
            text-shadow: 0 0 14px rgba(0, 240, 255, 0.8);
        }

        /* Map Artwork Container */
        .map-bg {
            position: relative;
            flex: 1;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        .map-bg canvas {
            width: 100%;
            height: 100%;
            display: block;
        }

        /* Bottom Index Tag inside each column */
        .map-footer-tag {
            position: absolute;
            bottom: 18px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            font-family: 'Oswald', sans-serif;
            font-size: 0.78rem;
            letter-spacing: 0.18em;
            color: rgba(255, 255, 255, 0.55);
            background: rgba(5, 10, 24, 0.76);
            border: 1px solid rgba(255, 255, 255, 0.14);
            padding: 0.25rem 0.75rem;
            border-radius: 4px;
            text-transform: uppercase;
            white-space: nowrap;
            transition: all 0.18s ease;
        }

        .map-col.active .map-footer-tag {
            color: var(--cyan-glow);
            border-color: rgba(0, 240, 255, 0.65);
            background: rgba(5, 15, 38, 0.92);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.35);
        }

        /* =========================================
           CINEMATIC FLASH & FULL-SCREEN WINNER REVEAL
           ========================================= */
        .flash-bang {
            position: fixed;
            inset: 0;
            background: #ffffff;
            z-index: 90;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.45s ease-out;
        }

        .flash-bang.trigger {
            opacity: 0.95;
            transition: none;
        }

        .reveal-overlay {
            position: fixed;
            inset: 0;
            z-index: 75;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #040916;
            opacity: 0;
            pointer-events: none;
            transform: scale(1.08);
            transition: opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1), transform 0.55s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
        }

        .reveal-overlay.visible {
            opacity: 1;
            pointer-events: auto;
            transform: scale(1);
        }

        .reveal-bg-canvas {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            filter: brightness(0.95) contrast(1.08);
        }

        .reveal-vignette {
            position: absolute;
            inset: 0;
            z-index: 2;
            background:
                linear-gradient(90deg, rgba(4, 9, 22, 0.72) 0%, rgba(4, 9, 22, 0.2) 45%, rgba(4, 9, 22, 0.78) 100%),
                radial-gradient(circle at 62% 50%, transparent 25%, rgba(3, 7, 18, 0.82) 100%);
        }

        /* Top-Left Uploaded Logo Watermark on Reveal Screen */
        .reveal-top-brand {
            position: absolute;
            top: 24px;
            left: 28px;
            z-index: 20;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            background: rgba(4, 9, 22, 0.85);
            border: 1px solid rgba(0, 240, 255, 0.45);
            padding: 0.5rem 0.95rem;
            border-radius: 8px;
            box-shadow: 0 0 22px rgba(0, 0, 0, 0.78);
        }

        .reveal-top-brand img {
            width: 44px;
            height: 44px;
            object-fit: contain;
            flex-shrink: 0;
            filter: drop-shadow(0 0 8px rgba(0, 240, 255, 0.4));
        }

        .reveal-top-brand-text {
            font-family: 'Oswald', sans-serif;
            font-size: 0.96rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: #ffffff;
            text-transform: uppercase;
        }

        /* Diagonal Yellow Caution / Hazard Ticker Tape */
        .hazard-tape-container {
            position: absolute;
            top: -15%;
            left: 23%;
            width: 72px;
            height: 140%;
            z-index: 10;
            transform: rotate(15deg);
            background: var(--gold-bright);
            box-shadow: 0 0 38px rgba(0, 0, 0, 0.88), 0 0 28px rgba(255, 230, 0, 0.5);
            border-left: 4px solid #040916;
            border-right: 4px solid #040916;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hazard-tape-track {
            display: flex;
            flex-direction: column;
            white-space: nowrap;
            animation: scrollTapeVertical 8.5s linear infinite;
        }

        .hazard-tape-text {
            writing-mode: vertical-rl;
            text-orientation: mixed;
            font-family: 'Oswald', sans-serif;
            font-size: 1.65rem;
            font-weight: 700;
            letter-spacing: 0.14em;
            color: #040916;
            padding: 1rem 0;
            text-transform: uppercase;
        }

        @keyframes scrollTapeVertical {
            0% { transform: translateY(0); }
            100% { transform: translateY(-50%); }
        }

        /* Parallel Cyan Accent Slash */
        .cyan-slash-line {
            position: absolute;
            top: -15%;
            left: calc(23% + 86px);
            width: 6px;
            height: 140%;
            z-index: 9;
            transform: rotate(15deg);
            background: var(--cyan-glow);
            box-shadow: 0 0 18px var(--cyan-glow);
            opacity: 0.88;
        }

        /* Layered Kinetic Esports Typography on Right/Center */
        .reveal-content {
            position: relative;
            z-index: 15;
            margin-left: 31%;
            padding: 2rem 3rem;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .reveal-kicker {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            background: rgba(0, 240, 255, 0.16);
            border: 1px solid var(--cyan-glow);
            color: var(--cyan-glow);
            font-family: 'Oswald', sans-serif;
            font-size: 0.95rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            padding: 0.35rem 0.95rem;
            border-radius: 4px;
            margin-bottom: 0.85rem;
            text-transform: uppercase;
            box-shadow: 0 0 22px rgba(0, 240, 255, 0.28);
        }

        .kinetic-title-stack {
            position: relative;
            display: flex;
            flex-direction: column;
            line-height: 0.88;
        }

        .kinetic-ghost-top,
        .kinetic-ghost-bottom {
            font-family: 'Oswald', sans-serif;
            font-size: clamp(3.6rem, 7.6vw, 8.2rem);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: transparent;
            -webkit-text-stroke: 1.6px rgba(255, 255, 255, 0.32);
            pointer-events: none;
            transition: transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .kinetic-ghost-top {
            transform: translate(22px, 16px);
        }

        .kinetic-ghost-bottom {
            transform: translate(-18px, -16px);
            -webkit-text-stroke: 1.6px rgba(0, 240, 255, 0.42);
        }

        .reveal-overlay.visible .kinetic-ghost-top {
            transform: translate(12px, 8px);
        }

        .reveal-overlay.visible .kinetic-ghost-bottom {
            transform: translate(-12px, -8px);
        }

        .kinetic-main-title {
            font-family: 'Oswald', sans-serif;
            font-size: clamp(3.8rem, 8vw, 8.6rem);
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #ffffff;
            text-shadow:
                0 6px 32px rgba(0, 0, 0, 0.92),
                0 0 42px rgba(0, 240, 255, 0.55);
            position: relative;
            z-index: 2;
        }

        .reveal-subtitle-bar {
            margin-top: 1.35rem;
            display: flex;
            align-items: center;
            gap: 1rem;
            background: rgba(4, 9, 22, 0.88);
            border-left: 4px solid var(--gold-bright);
            padding: 0.65rem 1.3rem;
            border-radius: 0 6px 6px 0;
        }

        .reveal-subtitle-text {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.15rem;
            font-weight: 700;
            letter-spacing: 0.18em;
            color: var(--gold-bright);
            text-transform: uppercase;
        }

        .reveal-desc {
            margin-top: 0.9rem;
            max-width: 560px;
            font-size: 1.08rem;
            line-height: 1.45;
            color: rgba(235, 245, 255, 0.92);
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.88);
        }

        /* Responsive adjustments */
        @media (max-width: 960px) {
            .container {
                flex-direction: column;
            }
            .left-panel {
                width: 100%;
                height: auto;
                min-width: unset;
                padding: 1rem 1.25rem;
                flex-direction: row;
                align-items: center;
                border-right: none;
                border-bottom: 2px solid rgba(0, 240, 255, 0.35);
            }
            .title-mapdraw {
                flex-direction: row;
                gap: 0.5rem;
                align-items: baseline;
            }
            .title-random, .title-map, .title-draw {
                font-size: 2rem;
            }
            .title-accent-line, .system-status-bar {
                display: none;
            }
            .right-panel {
                width: 100%;
                flex: 1;
            }
            .hazard-tape-container {
                left: 8%;
                width: 48px;
            }
            .cyan-slash-line {
                left: calc(8% + 58px);
            }
            .reveal-content {
                margin-left: 18%;
                padding: 1.5rem;
            }
        }
    </style>
</head>
<body>
    <!-- Subtle Tech Grid & Vignette -->
    <div class="tech-grid-overlay"></div>
    <div class="vignette-overlay"></div>

    <!-- Screen Flash Impact -->
    <div id="flashBang" class="flash-bang"></div>

    <!-- Main Split-Screen Broadcast Container -->
    <div class="container">
        <!-- LEFT PANEL (~26% Width) -->
        <aside class="left-panel">
            <div class="brand-header">
                <div class="lole-brand-card">
                    <div class="lole-logo-wrap">
                        <img src="data:image/png;base64," alt="Legion of Lures Esports Logo">
                    </div>
                    <div class="lole-badge-text">
                        <span class="lole-title-main">LOLE ESPORTS</span>
                        <span class="lole-title-sub">TOURNAMENT</span>
                        <span class="lole-org-tag">LEGION OF LURES // MAP DRAW</span>
                    </div>
                </div>

                <div class="system-status-bar">
                    <span id="statusDot" class="status-dot drawing"></span>
                    <span id="statusText">INITIALIZING RANDOM DRAW...</span>
                </div>
            </div>

            <!-- Clean Broadcast Title Stack (No Start Buttons) -->
            <div class="bottom-section">
                <div class="title-mapdraw">
                    <span class="title-random">RANDOM</span>
                    <span class="title-map">MAP</span>
                    <span class="title-draw">DRAW</span>
                    <div class="title-accent-line"></div>
                </div>
            </div>
        </aside>

        <!-- RIGHT PANEL (~74% Width) - 4 Map Choices -->
        <main class="right-panel" id="rightPanel">
            <!-- Global Sliding Arrow Indicator -->
            <div class="draw-arrow" id="drawArrow"></div>

            <!-- Column 0: FLYING CLOUDS -->
            <div class="map-col active" id="map-0" data-index="0">
                <div class="map-header">
                    <div class="map-icon"></div>
                    <div class="map-title">FLYING CLOUDS</div>
                </div>
                <div class="map-bg">
                    <canvas id="canvas-map-0"></canvas>
                    <div class="map-footer-tag">MAP 01 // FLYING CLOUDS</div>
                </div>
            </div>

            <!-- Column 1: REVEALING WISPS -->
            <div class="map-col" id="map-1" data-index="1">
                <div class="map-header">
                    <div class="map-icon"></div>
