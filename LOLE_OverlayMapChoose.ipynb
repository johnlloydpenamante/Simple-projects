                </div>
            </div>
        </main>
    </div>

    <!-- =========================================
         FULL-SCREEN CINEMATIC WINNER REVEAL OVERLAY
         ========================================= -->
    <section id="revealOverlay" class="reveal-overlay" aria-hidden="true">
        <canvas id="revealBgCanvas" class="reveal-bg-canvas"></canvas>
        <div class="reveal-vignette"></div>

        <!-- Top-Left Uploaded Logo Badge -->
        <div class="reveal-top-brand">
            <img src="data:image/png;base64," alt="Legion of Lures Esports Logo">
            <span class="reveal-top-brand-text">LOLE ESPORTS TOURNAMENT</span>
        </div>

        <!-- Diagonal Yellow Caution / Hazard Ticker Tape -->
        <div class="hazard-tape-container">
            <div id="hazardTapeTrack" class="hazard-tape-track"></div>
        </div>
        <div class="cyan-slash-line"></div>

        <!-- Layered Kinetic Typography -->
        <div class="reveal-content">
            <div class="reveal-kicker">
                <span>LOLE ESPORTS TOURNAMENT</span>
                <span>//</span>
                <span>BATTLEGROUND CONFIRMED</span>
            </div>

            <div class="kinetic-title-stack">
                <div id="kineticGhostTop" class="kinetic-ghost-top">FLYING CLOUDS</div>
                <h1 id="kineticMainTitle" class="kinetic-main-title">FLYING CLOUDS</h1>
                <div id="kineticGhostBottom" class="kinetic-ghost-bottom">FLYING CLOUDS</div>
            </div>

            <div class="reveal-subtitle-bar">
                <span class="reveal-subtitle-text">SELECTED BATTLEGROUND // MATCH READY</span>
            </div>

            <p id="revealDesc" class="reveal-desc">
                Sky-blue wind currents and floating cloud sanctuaries sweep across the arena, enabling rapid cross-map rotations and high-mobility aerial plays.
            </p>
        </div>
    </section>

    <script>
        (function () {
            'use strict';

            /* =========================================================
               1. MAP DATA (Matched to MLBB 4 Maps Photo & Icons)
               ========================================================= */
            const MAPS = [
                {
                    id: 0,
                    name: 'FLYING CLOUDS',
                    description: 'Sky-blue wind currents and billowing cloud platforms sweep across the Land of Dawn, enabling rapid rotations and aerial engages.',
                    primaryColor: '#7dd3fc',
                    secondaryColor: '#38bdf8',
                    accentColor: '#e0f2fe'
                },
                {
                    id: 1,
                    name: 'REVEALING WISPS',
                    description: 'Luminous cyan spirit wisps hover across the jungle and river, illuminating hidden paths and exposing enemy ambushes.',
                    primaryColor: '#00f0ff',
                    secondaryColor: '#0284c7',
                    accentColor: '#cffafe'
                },
                {
                    id: 2,
                    name: 'HEALING TURTLE',
                    description: 'Emerald-lime crystalline turtle shells radiate restorative energy across the river basin, sustaining extended teamfights.',
                    primaryColor: '#22c55e',
                    secondaryColor: '#bef264',
                    accentColor: '#dcfce7'
                },
                {
                    id: 3,
                    name: 'GOLDEN TURRET',
                    description: 'Gilded fortress turrets and golden crossbows fortify the lanes with radiant energy beams and high-stakes objective defense.',
                    primaryColor: '#facc15',
                    secondaryColor: '#eab308',
                    accentColor: '#fef9c3'
                }
            ];

            /* =========================================================
               2. STATE & DOM REFERENCES
               ========================================================= */
            let activeIndex = 0;
            let isDrawing = false;
            let isRevealed = false;

            const drawArrow = document.getElementById('drawArrow');
            const columns = [
                document.getElementById('map-0'),
                document.getElementById('map-1'),
                document.getElementById('map-2'),
                document.getElementById('map-3')
            ];
            const columnCanvases = [
                document.getElementById('canvas-map-0'),
                document.getElementById('canvas-map-1'),
                document.getElementById('canvas-map-2'),
                document.getElementById('canvas-map-3')
            ];

            const statusDot = document.getElementById('statusDot');
            const statusText = document.getElementById('statusText');
            const flashBang = document.getElementById('flashBang');

            const revealOverlay = document.getElementById('revealOverlay');
            const revealBgCanvas = document.getElementById('revealBgCanvas');
            const hazardTapeTrack = document.getElementById('hazardTapeTrack');
            const kineticGhostTop = document.getElementById('kineticGhostTop');
            const kineticMainTitle = document.getElementById('kineticMainTitle');
            const kineticGhostBottom = document.getElementById('kineticGhostBottom');
            const revealDesc = document.getElementById('revealDesc');

            /* =========================================================
               3. WEB AUDIO SYNTHESIZED BROADCAST SFX (Auto-unlocks)
               ========================================================= */
            let audioCtx = null;

            function ensureAudioContext() {
                if (!audioCtx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    if (AudioContext) {
                        audioCtx = new AudioContext();
                    }
                }
                if (audioCtx && audioCtx.state === 'suspended') {
                    audioCtx.resume().catch(() => {});
                }
            }

            ['pointerdown', 'keydown', 'touchstart'].forEach((evt) => {
                window.addEventListener(evt, ensureAudioContext, { once: true });
            });

            function playTickSound(stepIndex, progress) {
                try {
                    ensureAudioContext();
                    if (!audioCtx || audioCtx.state !== 'running') return;

                    const now = audioCtx.currentTime;
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();

                    const baseFreq = 520 + progress * 340 + (stepIndex % 4) * 35;
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(baseFreq, now);
                    osc.frequency.exponentialRampToValueAtTime(baseFreq * 0.55, now + 0.055);

                    gain.gain.setValueAtTime(0.11, now);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);

                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    osc.start(now);
                    osc.stop(now + 0.065);
                } catch (e) {}
            }

            function playLockInSound() {
                try {
                    ensureAudioContext();
                    if (!audioCtx || audioCtx.state !== 'running') return;

                    const now = audioCtx.currentTime;
                    [261.63, 329.63, 392.0, 523.25].forEach((freq, idx) => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'sawtooth';
                        osc.frequency.setValueAtTime(freq, now + idx * 0.03);

                        gain.gain.setValueAtTime(0.08, now + idx * 0.03);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);

                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(now + idx * 0.03);
                        osc.stop(now + 0.48);
                    });
                } catch (e) {}
            }

            function playRevealStinger() {
                try {
                    ensureAudioContext();
                    if (!audioCtx || audioCtx.state !== 'running') return;

                    const now = audioCtx.currentTime;
                    const subOsc = audioCtx.createOscillator();
                    const subGain = audioCtx.createGain();
                    subOsc.type = 'sine';
                    subOsc.frequency.setValueAtTime(140, now);
                    subOsc.frequency.exponentialRampToValueAtTime(36, now + 0.75);

                    subGain.gain.setValueAtTime(0.28, now);
                    subGain.gain.exponentialRampToValueAtTime(0.001, now + 0.8);

                    subOsc.connect(subGain);
                    subGain.connect(audioCtx.destination);
                    subOsc.start(now);
                    subOsc.stop(now + 0.85);

                    [293.66, 440.0, 587.33, 739.99].forEach((freq) => {
                        const osc = audioCtx.createOscillator();
                        const gain = audioCtx.createGain();
                        osc.type = 'triangle';
                        osc.frequency.setValueAtTime(freq, now);

                        gain.gain.setValueAtTime(0.075, now);
                        gain.gain.exponentialRampToValueAtTime(0.001, now + 1.15);

                        osc.connect(gain);
                        gain.connect(audioCtx.destination);
                        osc.start(now);
                        osc.stop(now + 1.2);
                    });
                } catch (e) {}
            }

            /* =========================================================
               4. CUSTOM ILLUSTRATED BATTLEGROUND ARTWORK + MLBB EMBLEMS
               ========================================================= */
            const dustParticles = Array.from({ length: 48 }, (_, i) => ({
                x: (i * 0.173) % 1,
                y: (i * 0.291) % 1,
                r: 1.2 + (i % 3) * 0.85,
                vx: ((i % 5) - 2) * 0.004,
                vy: -0.005 - (i % 4) * 0.003,
                alpha: 0.25 + (i % 5) * 0.12
            }));

            function drawMobaTerrainBase(ctx, w, h, tintHex) {
                ctx.save();
                ctx.strokeStyle = tintHex;
                ctx.lineWidth = 1.5;
                ctx.beginPath();
                ctx.moveTo(0, h * 0.22);
                ctx.bezierCurveTo(w * 0.35, h * 0.42, w * 0.65, h * 0.58, w, h * 0.78);
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(w * 0.15, h);
                ctx.quadraticCurveTo(w * 0.5, h * 0.5, w * 0.85, 0);
                ctx.stroke();

                ctx.beginPath();
                ctx.ellipse(w * 0.5, h * 0.52, w * 0.28, h * 0.12, 0, 0, Math.PI * 2);
                ctx.stroke();
                ctx.restore();
            }

            function drawFlyingCloudEmblem(ctx, cx, cy, scale, timeSec) {
                ctx.save();
                const bob = Math.sin(timeSec * 2.2) * 6;
                ctx.translate(cx, cy + bob);
                ctx.scale(scale, scale);

                ctx.shadowColor = '#38bdf8';
                ctx.shadowBlur = 28;

                const grad = ctx.createLinearGradient(0, -68, 0, 68);
                grad.addColorStop(0, '#ffffff');
                grad.addColorStop(0.55, '#bae6fd');
                grad.addColorStop(1, '#38bdf8');

                ctx.fillStyle = grad;
                ctx.beginPath();
                ctx.arc(-26, -12, 34, Math.PI * 0.75, Math.PI * 1.95);
                ctx.arc(14, -22, 42, Math.PI * 1.05, Math.PI * 0.12);
                ctx.bezierCurveTo(68, -6, 62, 34, 24, 34);
                ctx.bezierCurveTo(8, 34, -2, 54, -14, 72);
                ctx.bezierCurveTo(-18, 48, -12, 32, -26, 26);
                ctx.bezierCurveTo(-56, 20, -60, -8, -42, -16);
                ctx.closePath();
                ctx.fill();

                ctx.shadowBlur = 0;

                ctx.fillStyle = '#0c2d5e';
                ctx.beginPath();
                ctx.moveTo(42, 4);
                ctx.bezierCurveTo(22, -14, -4, -6, -6, 14);
                ctx.bezierCurveTo(-7, 26, 4, 36, -6, 52);
                ctx.bezierCurveTo(10, 38, 12, 22, 6, 12);
                ctx.bezierCurveTo(2, 4, 22, -2, 42, 4);
                ctx.closePath();
                ctx.fill();

                ctx.restore();
            }

            function drawRevealingWispEmblem(ctx, cx, cy, scale, timeSec) {
                ctx.save();
                const bob = Math.sin(timeSec * 2.4 + 1.1) * 6;
                ctx.translate(cx, cy + bob);
                ctx.scale(scale, scale);

                ctx.shadowColor = '#00f0ff';
                ctx.shadowBlur = 30;

                const petalGrad = ctx.createLinearGradient(-55, -65, 45, 55);
                petalGrad.addColorStop(0, '#ffffff');
                petalGrad.addColorStop(0.5, '#67e8f9');
                petalGrad.addColorStop(1, '#06b6d4');

                ctx.fillStyle = petalGrad;

                ctx.beginPath();
                ctx.moveTo(-4, -14);
                ctx.bezierCurveTo(-2, -46, 16, -66, 30, -78);
                ctx.bezierCurveTo(34, -52, 32, -24, 16, -8);
                ctx.closePath();
                ctx.fill();

                ctx.beginPath();
                ctx.moveTo(-14, -4);
                ctx.bezierCurveTo(-42, -12, -62, -28, -76, -42);
                ctx.bezierCurveTo(-52, -44, -26, -38, -8, -18);
                ctx.closePath();
                ctx.fill();

                ctx.beginPath();
                ctx.moveTo(-16, 12);
                ctx.bezierCurveTo(-28, 32, -32, 54, -26, 72);
                ctx.bezierCurveTo(-12, 58, -2, 38, 2, 18);
                ctx.closePath();
                ctx.fill();

                ctx.beginPath();
                ctx.moveTo(18, 4);
                ctx.quadraticCurveTo(44, 14, 52, 26);
                ctx.quadraticCurveTo(32, 28, 14, 18);
                ctx.closePath();
                ctx.fill();

                ctx.shadowBlur = 0;

                ctx.beginPath();
                ctx.arc(0, 2, 25, 0, Math.PI * 2);
                ctx.fillStyle = '#083344';
                ctx.fill();
                ctx.lineWidth = 4;
                ctx.strokeStyle = '#67e8f9';
                ctx.stroke();

                ctx.beginPath();
                ctx.arc(0, 2, 12, 0, Math.PI * 2);
                ctx.fillStyle = '#a5f3fc';
                ctx.fill();

                ctx.restore();
            }

            function drawHealingTurtleEmblem(ctx, cx, cy, scale, timeSec) {
                ctx.save();
                const bob = Math.sin(timeSec * 2.0 + 2.2) * 6;
                ctx.translate(cx, cy + bob);
                ctx.scale(scale, scale);

                ctx.shadowColor = '#22c55e';
                ctx.shadowBlur = 28;

                const segments = [
                    {
                        pts: [[-56, -24], [-34, -54], [-6, -56], [-32, -2], [-54, 18]],
                        c1: '#fef08a', c2: '#84cc16'
                    },
                    {
                        pts: [[-34, -4], [-8, -54], [22, -44], [-6, 16], [-36, 36]],
                        c1: '#d9f99d', c2: '#22c55e'
                    },
                    {
                        pts: [[-8, 14], [20, -42], [46, -24], [18, 28], [-12, 46]],
                        c1: '#86efac', c2: '#16a34a'
                    },
                    {
                        pts: [[16, 26], [44, -22], [68, 4], [38, 34], [10, 44]],
                        c1: '#4ade80', c2: '#15803d'
                    }
                ];

                segments.forEach((seg) => {
                    const g = ctx.createLinearGradient(-45, -50, 55, 45);
                    g.addColorStop(0, seg.c1);
                    g.addColorStop(1, seg.c2);

                    ctx.fillStyle = g;
                    ctx.strokeStyle = '#052e16';
                    ctx.lineWidth = 3.5;
                    ctx.lineJoin = 'round';

                    ctx.beginPath();
                    seg.pts.forEach(([px, py], i) => {
                        if (i === 0) ctx.moveTo(px, py);
                        else ctx.lineTo(px, py);
                    });
                    ctx.closePath();
                    ctx.fill();
                    ctx.stroke();
                });

                ctx.shadowBlur = 0;
                ctx.restore();
            }

            function drawGoldenTurretEmblem(ctx, cx, cy, scale, timeSec) {
                ctx.save();
                const bob = Math.sin(timeSec * 2.1 + 3.4) * 6;
                ctx.translate(cx, cy + bob);
                ctx.scale(scale, scale);

                ctx.shadowColor = '#facc15';
                ctx.shadowBlur = 28;

                const goldGrad = ctx.createLinearGradient(-50, -65, 50, 65);
                goldGrad.addColorStop(0, '#fef9c3');
                goldGrad.addColorStop(0.45, '#facc15');
                goldGrad.addColorStop(1, '#ca8a04');

                ctx.fillStyle = goldGrad;
                ctx.strokeStyle = '#422006';
                ctx.lineWidth = 3.2;
                ctx.lineJoin = 'round';

                ctx.beginPath();
                ctx.roundRect(-24, 38, 48, 16, 7);
                ctx.fill();
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(-18, 38);
                ctx.lineTo(-15, 6);
                ctx.lineTo(15, 6);
                ctx.lineTo(18, 38);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.beginPath();
                ctx.roundRect(-21, -2, 42, 11, 5);
                ctx.fill();
                ctx.stroke();

                ctx.save();
                ctx.translate(2, -26);
                ctx.rotate(-0.62);

                ctx.beginPath();
                ctx.moveTo(-48, -18);
                ctx.quadraticCurveTo(0, 12, 48, -18);
                ctx.lineTo(42, -6);
                ctx.quadraticCurveTo(0, 22, -42, -6);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.beginPath();
                ctx.moveTo(-44, -14);
                ctx.lineTo(0, 26);
                ctx.lineTo(44, -14);
                ctx.strokeStyle = '#fef08a';
                ctx.lineWidth = 2.5;
                ctx.stroke();

                ctx.fillStyle = '#fef9c3';
                ctx.strokeStyle = '#422006';
                ctx.lineWidth = 2.8;
                ctx.beginPath();
                ctx.moveTo(0, -44);
                ctx.lineTo(9, -22);
                ctx.lineTo(4, -22);
                ctx.lineTo(4, 30);
                ctx.lineTo(-4, 30);
                ctx.lineTo(-4, -22);
                ctx.lineTo(-9, -22);
                ctx.closePath();
                ctx.fill();
                ctx.stroke();

                ctx.restore();
                ctx.shadowBlur = 0;
                ctx.restore();
            }

            function drawMapArtwork(ctx, w, h, mapIndex, timeSec, isFullReveal = false) {
                ctx.save();
                ctx.clearRect(0, 0, w, h);

                const emblemScale = isFullReveal
                    ? Math.min(w, h) / 420
                    : Math.min(w / 240, h / 540);
                const emblemX = isFullReveal ? w * 0.14 : w * 0.5;
                const emblemY = isFullReveal ? h * 0.52 : h * 0.48;

                if (mapIndex === 0) {
                    const bgGrad = ctx.createLinearGradient(0, 0, 0, h);
                    bgGrad.addColorStop(0, '#071b42');
                    bgGrad.addColorStop(0.46, '#14448a');
                    bgGrad.addColorStop(0.84, '#0e2859');
                    bgGrad.addColorStop(1, '#050d21');
                    ctx.fillStyle = bgGrad;
                    ctx.fillRect(0, 0, w, h);

                    const skyGlow = ctx.createRadialGradient(w * 0.5, h * 0.44, 10, w * 0.5, h * 0.44, Math.max(w, h) * 0.65);
                    skyGlow.addColorStop(0, 'rgba(125, 211, 252, 0.52)');
                    skyGlow.addColorStop(0.45, 'rgba(56, 189, 248, 0.2)');
                    skyGlow.addColorStop(1, 'transparent');
                    ctx.fillStyle = skyGlow;
                    ctx.fillRect(0, 0, w, h);

                    drawMobaTerrainBase(ctx, w, h, 'rgba(125, 211, 252, 0.14)');

                    for (let s = 0; s < 5; s++) {
                        const yWave = h * (0.2 + s * 0.15);
                        ctx.beginPath();
                        for (let x = 0; x <= w; x += 14) {
                            const wy = yWave + Math.sin(x * 0.02 + timeSec * 2.5 + s) * 14;
                            if (x === 0) ctx.moveTo(x, wy);
                            else ctx.lineTo(x, wy);
                        }
                        ctx.strokeStyle = s % 2 === 0 ? 'rgba(186, 230, 253, 0.26)' : 'rgba(0, 240, 255, 0.2)';
                        ctx.lineWidth = 2;
                        ctx.stroke();
                    }

                    [
                        { cx: 0.22, cy: 0.28, r: 0.14, sp: 10 },
                        { cx: 0.78, cy: 0.34, r: 0.16, sp: -12 },
                        { cx: 0.25, cy: 0.76, r: 0.18, sp: 14 },
                        { cx: 0.76, cy: 0.74, r: 0.17, sp: -11 }
                    ].forEach((c, idx) => {
                        const bx = w * c.cx + Math.sin(timeSec * 0.9 + idx) * c.sp;
                        const by = h * c.cy;
                        const br = Math.min(w, h) * c.r;
                        const cg = ctx.createLinearGradient(bx, by - br, bx, by + br);
                        cg.addColorStop(0, 'rgba(240, 249, 255, 0.42)');
                        cg.addColorStop(1, 'rgba(14, 48, 99, 0.15)');
                        ctx.fillStyle = cg;
                        ctx.beginPath();
                        ctx.arc(bx, by, br, 0, Math.PI * 2);
                        ctx.arc(bx - br * 0.7, by + br * 0.15, br * 0.7, 0, Math.PI * 2);
                        ctx.arc(bx + br * 0.75, by + br * 0.12, br * 0.75, 0, Math.PI * 2);
                        ctx.fill();
                    });

                    drawFlyingCloudEmblem(ctx, emblemX, emblemY, emblemScale, timeSec);

                } else if (mapIndex === 1) {
                    const bgGrad = ctx.createLinearGradient(0, 0, 0, h);
                    bgGrad.addColorStop(0, '#041426');
                    bgGrad.addColorStop(0.48, '#083354');
                    bgGrad.addColorStop(1, '#040d1c');
                    ctx.fillStyle = bgGrad;
                    ctx.fillRect(0, 0, w, h);

                    const aura = ctx.createRadialGradient(w * 0.5, h * 0.46, 12, w * 0.5, h * 0.46, Math.max(w, h) * 0.65);
                    aura.addColorStop(0, 'rgba(0, 240, 255, 0.45)');
                    aura.addColorStop(0.5, 'rgba(6, 182, 212, 0.18)');
                    aura.addColorStop(1, 'transparent');
                    ctx.fillStyle = aura;
                    ctx.fillRect(0, 0, w, h);

                    drawMobaTerrainBase(ctx, w, h, 'rgba(0, 240, 255, 0.15)');

                    [
                        { bx: 0.24, by: 0.26, rx: 0.08, ry: 0.05, sp: 1.7, ph: 0 },
                        { bx: 0.76, by: 0.30, rx: 0.09, ry: 0.06, sp: 1.4, ph: 1.8 },
                        { bx: 0.28, by: 0.72, rx: 0.10, ry: 0.05, sp: 1.9, ph: 3.1 },
                        { bx: 0.74, by: 0.74, rx: 0.08, ry: 0.06, sp: 1.5, ph: 4.5 }
                    ].forEach((wp) => {
                        const wx = w * wp.bx + Math.cos(timeSec * wp.sp + wp.ph) * (w * wp.rx);
                        const wy = h * wp.by + Math.sin(timeSec * wp.sp * 1.2 + wp.ph) * (h * wp.ry);
                        const wg = ctx.createRadialGradient(wx, wy, 1, wx, wy, 30);
                        wg.addColorStop(0, '#ffffff');
                        wg.addColorStop(0.3, '#00f0ff');
                        wg.addColorStop(1, 'transparent');
                        ctx.fillStyle = wg;
                        ctx.beginPath();
                        ctx.arc(wx, wy, 30, 0, Math.PI * 2);
                        ctx.fill();
                    });

                    drawRevealingWispEmblem(ctx, emblemX, emblemY, emblemScale, timeSec);

                } else if (mapIndex === 2) {
                    const bgGrad = ctx.createLinearGradient(0, 0, 0, h);
                    bgGrad.addColorStop(0, '#041f14');
                    bgGrad.addColorStop(0.48, '#0b4229');
                    bgGrad.addColorStop(1, '#03170e');
                    ctx.fillStyle = bgGrad;
                    ctx.fillRect(0, 0, w, h);

                    const healGlow = ctx.createRadialGradient(w * 0.5, h * 0.48, 12, w * 0.5, h * 0.48, Math.max(w, h) * 0.65);
                    healGlow.addColorStop(0, 'rgba(74, 222, 128, 0.48)');
                    healGlow.addColorStop(0.45, 'rgba(190, 242, 100, 0.18)');
                    healGlow.addColorStop(1, 'transparent');
                    ctx.fillStyle = healGlow;
                    ctx.fillRect(0, 0, w, h);

                    drawMobaTerrainBase(ctx, w, h, 'rgba(74, 222, 128, 0.15)');

                    for (let r = 0; r < 3; r++) {
                        const cycle = ((timeSec * 0.5) + r * 0.33) % 1;
                        const rx = (0.14 + cycle * 0.38) * Math.min(w * 1.1, h * 0.85);
                        const ry = rx * 0.52;
                        const alpha = (1 - cycle) * 0.55;
                        ctx.beginPath();
                        ctx.ellipse(w * 0.5, h * 0.56, rx, ry, 0, 0, Math.PI * 2);
                        ctx.strokeStyle = `rgba(134, 239, 172, ${alpha.toFixed(3)})`;
                        ctx.lineWidth = 2.4;
                        ctx.stroke();
                    }

                    for (let p = 0; p < 6; p++) {
                        const pCycle = ((timeSec * 0.55) + p * 0.16) % 1;
                        const px = w * (0.25 + (p % 4) * 0.16);
                        const py = h * (0.78 - pCycle * 0.52);
                        const pAlpha = (1 - pCycle) * 0.75;
                        ctx.strokeStyle = `rgba(217, 249, 157, ${pAlpha.toFixed(3)})`;
                        ctx.lineWidth = 2.2;
                        ctx.beginPath();
                        ctx.moveTo(px - 6, py);
                        ctx.lineTo(px + 6, py);
                        ctx.moveTo(px, py - 6);
                        ctx.lineTo(px, py + 6);
                        ctx.stroke();
                    }

                    drawHealingTurtleEmblem(ctx, emblemX, emblemY, emblemScale, timeSec);

                } else {
                    const bgGrad = ctx.createLinearGradient(0, 0, 0, h);
                    bgGrad.addColorStop(0, '#1f1504');
                    bgGrad.addColorStop(0.48, '#473007');
                    bgGrad.addColorStop(1, '#140e04');
                    ctx.fillStyle = bgGrad;
                    ctx.fillRect(0, 0, w, h);

                    const goldGlow = ctx.createRadialGradient(w * 0.5, h * 0.46, 12, w * 0.5, h * 0.46, Math.max(w, h) * 0.65);
                    goldGlow.addColorStop(0, 'rgba(250, 204, 21, 0.55)');
                    goldGlow.addColorStop(0.45, 'rgba(234, 179, 8, 0.22)');
                    goldGlow.addColorStop(1, 'transparent');
                    ctx.fillStyle = goldGlow;
                    ctx.fillRect(0, 0, w, h);

                    drawMobaTerrainBase(ctx, w, h, 'rgba(250, 204, 21, 0.16)');

                    ctx.save();
                    const beamAngle = Math.sin(timeSec * 1.3) * 0.22;
                    ctx.translate(w * 0.5, h * 0.22);
                    ctx.rotate(beamAngle);
                    const beamGrad = ctx.createLinearGradient(0, 0, 0, h * 0.72);
                    beamGrad.addColorStop(0, 'rgba(254, 240, 138, 0.34)');
                    beamGrad.addColorStop(1, 'transparent');
                    ctx.fillStyle = beamGrad;
                    ctx.beginPath();
                    ctx.moveTo(-10, 0);
                    ctx.lineTo(-w * 0.38, h * 0.72);
                    ctx.lineTo(w * 0.38, h * 0.72);
                    ctx.lineTo(10, 0);
                    ctx.closePath();
                    ctx.fill();
                    ctx.restore();

                    drawGoldenTurretEmblem(ctx, emblemX, emblemY, emblemScale, timeSec);
                }

                const themeColor = MAPS[mapIndex].primaryColor;
                dustParticles.forEach((p, idx) => {
                    const px = ((p.x + timeSec * p.vx * 18) % 1 + 1) % 1 * w;
                    const py = ((p.y + timeSec * p.vy * 18) % 1 + 1) % 1 * h;
                    ctx.beginPath();
                    ctx.arc(px, py, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = idx % 3 === 0 ? '#ffffff' : themeColor;
                    ctx.globalAlpha = p.alpha * 0.75;
                    ctx.fill();
                });

                ctx.restore();
            }

            function resizeCanvases() {
                const dpr = Math.min(window.devicePixelRatio || 1, 2);
                columnCanvases.forEach((canvas) => {
                    const rect = canvas.parentElement.getBoundingClientRect();
                    canvas.width = Math.max(1, Math.floor(rect.width * dpr));
                    canvas.height = Math.max(1, Math.floor(rect.height * dpr));
                });

                revealBgCanvas.width = Math.floor(window.innerWidth * dpr);
                revealBgCanvas.height = Math.floor(window.innerHeight * dpr);
                updateArrowPosition(activeIndex);
            }

            function renderLoop(nowMs) {
                const timeSec = nowMs * 0.001;

                columnCanvases.forEach((canvas, idx) => {
                    const ctx = canvas.getContext('2d');
                    if (ctx) {
                        drawMapArtwork(ctx, canvas.width, canvas.height, idx, timeSec, false);
                    }
                });

                if (isRevealed) {
                    const rCtx = revealBgCanvas.getContext('2d');
                    if (rCtx) {
                        drawMapArtwork(rCtx, revealBgCanvas.width, revealBgCanvas.height, activeIndex, timeSec, true);
                    }
                }

                requestAnimationFrame(renderLoop);
            }

            /* =========================================================
               5. SLIDING ARROW & COLUMN SELECTION
               ========================================================= */
            function updateArrowPosition(index) {
                const centerPercent = index * 25 + 12.5;
                drawArrow.style.left = `${centerPercent}%`;
            }

            function setActiveColumn(index, isWinnerLock = false) {
                activeIndex = ((index % 4) + 4) % 4;
                updateArrowPosition(activeIndex);

                columns.forEach((col, idx) => {
                    col.classList.toggle('active', idx === activeIndex);
                    col.classList.toggle('locked-winner', isWinnerLock && idx === activeIndex);
                });
            }

            /* =========================================================
               6. AUTOMATIC RANDOMIZER & CINEMATIC REVEAL
               ========================================================= */
            function triggerFlashBang() {
                flashBang.classList.add('trigger');
                requestAnimationFrame(() => {
                    requestAnimationFrame(() => {
                        flashBang.classList.remove('trigger');
                    });
                });
            }

            function populateHazardTape(mapName) {
                const repeated = Array.from({ length: 16 }, () => `${mapName} // `).join('');
                hazardTapeTrack.innerHTML = `
                    <div class="hazard-tape-text">${repeated}</div>
                    <div class="hazard-tape-text">${repeated}</div>
                `;
            }

            function showWinnerReveal(winnerIndex) {
                setActiveColumn(winnerIndex, true);
                const mapData = MAPS[winnerIndex];

                populateHazardTape(mapData.name);
                kineticGhostTop.textContent = mapData.name;
                kineticMainTitle.textContent = mapData.name;
                kineticGhostBottom.textContent = mapData.name;
                revealDesc.textContent = mapData.description;

                triggerFlashBang();
                playRevealStinger();
                isRevealed = true;
                revealOverlay.classList.add('visible');
                revealOverlay.setAttribute('aria-hidden', 'false');

                statusDot.classList.remove('drawing');
                statusText.textContent = `LOCKED // ${mapData.name}`;
            }

            function startAutomaticDraw() {
                if (isDrawing) return;

                isDrawing = true;
                statusDot.classList.add('drawing');
                statusText.textContent = 'RANDOMIZING BATTLEGROUND...';

                const winnerIndex = Math.floor(Math.random() * 4);

                const baseCycles = 7;
                const currentOffset = activeIndex;
                const deltaToWinner = (winnerIndex - currentOffset + 4) % 4;
                const totalSteps = baseCycles * 4 + deltaToWinner;

                let currentStep = 0;

                function scheduleNextStep() {
                    if (!isDrawing) return;

                    currentStep++;
                    const nextCol = (currentOffset + currentStep) % 4;
                    const progress = currentStep / totalSteps;

                    setActiveColumn(nextCol, false);
                    playTickSound(currentStep, progress);

                    if (currentStep >= totalSteps) {
                        isDrawing = false;
                        setActiveColumn(winnerIndex, true);
                        playLockInSound();
                        statusText.textContent = `SELECTED // ${MAPS[winnerIndex].name}`;

                        setTimeout(() => {
                            showWinnerReveal(winnerIndex);
                        }, 700);
                        return;
                    }

                    const eased = Math.pow(progress, 2.75);
                    const stepDelay = Math.round(48 + eased * 340);
                    setTimeout(scheduleNextStep, stepDelay);
                }

                scheduleNextStep();
            }

            window.addEventListener('resize', resizeCanvases);

            /* =========================================================
               7. AUTO-START ON LOAD (No buttons needed)
               ========================================================= */
            window.addEventListener('load', () => {
                resizeCanvases();
                setActiveColumn(0, false);
                requestAnimationFrame(renderLoop);

                setTimeout(() => {
                    startAutomaticDraw();
                }, 450);
            });
        })();
    </script>
</body>
</html>
