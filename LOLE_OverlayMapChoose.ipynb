            <!-- Column 2: HEALING TURTLE -->
            <div class="map-col" id="map-2" data-index="2">
                <div class="map-header">
                    <div class="map-icon"></div>
                    <div class="map-title">HEALING TURTLE</div>
                </div>
                <div class="map-bg">
                    <canvas id="canvas-map-2"></canvas>
                    <div class="map-footer-tag">MAP 03 // HEALING TURTLE</div>
                </div>
            </div>

            <!-- Column 3: GOLDEN TURRET -->
            <div class="map-col" id="map-3" data-index="3">
                <div class="map-header">
                    <div class="map-icon"></div>
                    <div class="map-title">GOLDEN TURRET</div>
                </div>
                <div class="map-bg">
                    <canvas id="canvas-map-3"></canvas>
